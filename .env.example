# 复制为 .env 后填入真实值：
#   Windows CMD:  copy .env.example .env
#   Git Bash:     cp .env.example .env
#
# 只有 key 需要替换。URL 和模型名是真实值，可直接用。

# ---------- 主模型：DeepSeek ----------
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---------- 备用模型：智谱 GLM ----------
# 主模型不可用时自动降级到这里（llm_client.ask() 按序重试）
# ⚠️ key 是「{id}.{secret}」两段式，中间的点号不能丢
GLM_API_KEY=你的id.你的secret
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-4-flash

# ---------- 天气查询：高德开放平台 ----------
GDMAP_API_KEY=你的key
GDMAP_API_URL=https://restapi.amap.com/v3/weather/weatherInfo

# ---------- 联网搜索：博查 ----------
BOCHA_API_KEY=sk-你的key
BOCHA_API_URL=https://api.bocha.cn/v1/web-search
